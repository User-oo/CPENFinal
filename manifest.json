
{
  "manifest_version": 3,
  "name": "Algorithm Reset",
  "version": "1.0",
  "description": "Filter social media content into educational topics.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}

